@page "/membership-fees"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IMembershipFeeQuangTtService FeeService
@inject IFeePackageQuangTtService PackageService
@inject IJSRuntime JS

<PageTitle>Membership Fees · ASM3</PageTitle>

<div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-2 mb-3">
    <div>
        <h1 class="h3 mb-1">Membership Fees</h1>
        <p class="text-muted mb-0">Blazor CRUD · tìm kiếm 3 tiêu chí · phân trang jQuery.</p>
    </div>
    <button type="button" class="btn btn-primary" @onclick="() => ShowForm(null)">
        Create New
    </button>
</div>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="alert @(isError ? "alert-danger" : "alert-success") alert-dismissible fade show" role="alert">
        @message
        <button type="button" class="btn-close" @onclick="() => message = null" aria-label="Close"></button>
    </div>
}

<form class="card card-body shadow-sm mb-3" @onsubmit="SearchAsync" @onsubmit:preventDefault>
    <div class="row g-2 align-items-end">
        <div class="col-md-3">
            <label class="form-label" for="searchMemberName">Tên hội viên</label>
            <input id="searchMemberName" class="form-control" @bind="memberName" placeholder="VD: Nguyễn Văn An" />
        </div>
        <div class="col-md-3">
            <label class="form-label" for="searchPaymentMethod">Phương thức thanh toán</label>
            <input id="searchPaymentMethod" class="form-control" @bind="paymentMethod" placeholder="Cash / Banking / Momo..." />
        </div>
        <div class="col-md-3">
            <label class="form-label" for="searchPackageName">Tên gói</label>
            <input id="searchPackageName" class="form-control" @bind="packageName" placeholder="VD: Premium" />
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-outline-primary">Tìm kiếm</button>
            <button type="button" class="btn btn-outline-secondary" @onclick="ClearSearchAsync">Xoá lọc</button>
        </div>
    </div>
</form>

@if (showForm)
{
    @if (selectedItem is null) { <CreateMembershipFee OnCancel="CloseForm" OnSaved="OnSavedAsync" /> }
    else { <EditMembershipFee Item="selectedItem" OnCancel="CloseForm" OnSaved="OnSavedAsync" /> }
}
<DeleteMembershipFee @ref="deleteComponent" OnDeleted="OnDeletedAsync" />
<div class="card shadow-sm">
    <div class="table-responsive">
        <table id="membershipFeeTable" class="table table-striped table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Hội viên</th>
                    <th>Thanh toán</th>
                    <th>Thời hạn</th>
                    <th>Gói</th>
                    <th>Trạng thái</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (items.Count == 0)
                {
                    <tr class="js-empty-row">
                        <td colspan="6" class="text-center text-muted py-4">Không có dữ liệu phù hợp.</td>
                    </tr>
                }
                else
                {
                    @foreach (var item in items)
                    {
                        <tr>
                            <td>
                                <div class="fw-semibold">@item.MemberName</div>
                                <div class="text-muted small">@item.TransactionCode</div>
                            </td>
                            <td>
                                <div class="fw-semibold">@item.Amount.ToString("N0") đ</div>
                                <div class="text-muted small">
                                    @item.PaymentMethod · @item.PaymentDate.ToString("dd/MM/yyyy")
                                </div>
                            </td>
                            <td>
                                <div>
                                    @(item.StartDate?.ToString("dd/MM/yyyy") ?? "-")
                                    →
                                    @(item.EndDate?.ToString("dd/MM/yyyy") ?? "-")
                                </div>
                                <div class="text-muted small">
                                    Publish: @(item.PublishDate?.ToString("dd/MM/yyyy") ?? "-")
                                </div>
                            </td>
                            <td>@(item.FeePackageQuangTt?.PackageName ?? "-")</td>
                            <td>
                                <div class="small">Status: @(item.Status?.ToString() ?? "-")</div>
                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="d-flex flex-wrap gap-1 justify-content-end">
                                    <button type="button" class="btn btn-sm btn-outline-primary"
                                            @onclick="() => ShowForm(item)">
                                        Edit
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-danger"
                                            @onclick="() => DeleteAsync(item)">
                                        Delete
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
    <div class="card-footer bg-white">
        <div class="d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-2">
            <div class="d-flex align-items-center gap-2">
                <label for="feePageSize" class="small text-muted mb-0">Số dòng/trang</label>
                <select id="feePageSize" class="form-select form-select-sm" style="width:auto">
                    <option value="5">5</option>
                    <option value="10" selected>10</option>
                    <option value="20">20</option>
                    <option value="50">50</option>
                </select>
            </div>
            <div id="feePageInfo" class="small text-muted"></div>
            <nav id="feePager" aria-label="Phân trang"></nav>
        </div>
    </div>
</div>

@code {
    private List<MembershipFeeQuangTt> items = new();
    private List<FeePackageQuangTt> packages = new();

    private bool showForm;

    private bool needsPagination;
    private string? memberName;
    private string? paymentMethod;
    private string? packageName;
    private string? message;
    private bool isError;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            packages = await PackageService.GetAllAsync();
        }
        catch (Exception ex)
        {
            SetError("Không tải được danh sách gói phí: " + ex.Message);
        }

        await SearchAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!needsPagination)
        {
            return;
        }

        needsPagination = false;

        try
        {
            await JS.InvokeVoidAsync("tablePagination.init", new
            {
                table = "#membershipFeeTable",
                pager = "#feePager",
                info = "#feePageInfo",
                pageSizeSelector = "#feePageSize",
                pageSize = 10
            });
        }
        catch (JSDisconnectedException)
        {
            // Circuit đã đóng, bỏ qua.
        }
    }

    private async Task SearchAsync()
    {
        try
        {
            items = await FeeService.SearchAsync(memberName, paymentMethod, packageName);
            needsPagination = true;
            isError = false;
        }
        catch (Exception ex)
        {
            SetError("Lỗi tìm kiếm: " + ex.Message);
        }
    }

    private async Task ClearSearchAsync()
    {
        memberName = null;
        paymentMethod = null;
        packageName = null;
        await SearchAsync();
    }

    private MembershipFeeQuangTt? selectedItem;
    private DeleteMembershipFee? deleteComponent;
    private void ShowForm(MembershipFeeQuangTt? item) { selectedItem = item; showForm = true; }
    private void CloseForm() { selectedItem = null; showForm = false; }
    private async Task OnSavedAsync(string text) { CloseForm(); message = text; await SearchAsync(); }
    private Task DeleteAsync(MembershipFeeQuangTt item) => deleteComponent!.DeleteAsync(item);
    private async Task OnDeletedAsync(string text) { message = text; await SearchAsync(); }
    private void SetError(string text)
    {
        message = text;
        isError = true;
    }
}
