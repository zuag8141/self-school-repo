@page "/"

<PageTitle>ASM3 · Blazor WebApp</PageTitle>

<div class="p-4 p-md-5 mb-4 bg-white rounded-3 shadow-sm">
    <h1 class="display-6 fw-semibold">ASM3 · ASP.NET Core Blazor WebApp</h1>
    <p class="lead mb-2">Quản lý <strong>Membership Fees</strong> với CRUD, tìm kiếm 3 tiêu chí và phân trang jQuery.</p>
    <p class="text-muted mb-4">
        Blazor Server (Interactive Server) · CRUD bằng component và EditForm.
        Trang Membership Fees yêu cầu đăng nhập bằng cookie.
    </p>
    <AuthorizeView>
        <Authorized>
            <a class="btn btn-primary btn-lg" href="membership-fees">Mở Membership Fees</a>
        </Authorized>
        <NotAuthorized>
            <a class="btn btn-primary btn-lg" href="login?returnUrl=%2Fmembership-fees">Đăng nhập để tiếp tục</a>
        </NotAuthorized>
    </AuthorizeView>
</div>

<div class="row g-3">
    <div class="col-md-6 col-xl-3">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <h2 class="h5">Blazor CRUD</h2>
                <p class="text-muted mb-0">Create / Read / Update / Delete bằng component, EditForm và DataAnnotations.</p>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <h2 class="h5">Đăng nhập cookie</h2>
                <p class="text-muted mb-0">Tài khoản mẫu: <code>admin / 123456</code>.</p>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <h2 class="h5">Interactive Server</h2>
                <p class="text-muted mb-0">Tương tác realtime qua kết nối nội bộ của Blazor Server.</p>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <h2 class="h5">Search &amp; Pagination</h2>
                <p class="text-muted mb-0">Tìm theo tên hội viên, phương thức thanh toán, tên gói; phân trang jQuery.</p>
            </div>
        </div>
    </div>
</div>
