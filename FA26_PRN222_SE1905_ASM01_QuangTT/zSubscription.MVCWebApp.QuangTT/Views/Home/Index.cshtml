@{
    ViewData["Title"] = "Home";
}

<div class="p-4 p-md-5 mb-4 bg-white rounded-3 shadow-sm">
    <h1 class="display-6 fw-semibold">ASM1 · ASP.NET Core MVC WebApp</h1>
    <p class="lead mb-2">Quản lý <strong>Membership Fees</strong> với CRUD, tìm kiếm 3 tiêu chí và phân trang jQuery.</p>
    <p class="text-muted mb-4">
        Assignment này dùng MVC thuần. CRUD được thực hiện bằng Razor View, form POST
        và Entity Framework Core.
    </p>
    <a asp-controller="MembershipFees" asp-action="Index" class="btn btn-primary btn-lg">Mở Membership Fees</a>
</div>

<div class="row g-3">
    <div class="col-md-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <h2 class="h5">CRUD MVC</h2>
                <p class="text-muted mb-0">Create / Details / Edit / Delete bằng Razor View + POST form.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <h2 class="h5">Tìm kiếm 3 tiêu chí</h2>
                <p class="text-muted mb-0">Tìm theo tên hội viên, phương thức thanh toán và tên gói phí.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <h2 class="h5">Phân trang jQuery</h2>
                <p class="text-muted mb-0">Bảng dữ liệu được phân trang phía client bằng jQuery.</p>
            </div>
        </div>
    </div>
</div>
