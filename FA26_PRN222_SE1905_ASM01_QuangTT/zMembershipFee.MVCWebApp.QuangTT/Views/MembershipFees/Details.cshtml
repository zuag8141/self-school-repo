@model zMembershipFee.Entities.QuangTT.Models.MembershipFeeQuangTt
@{
    ViewData["Title"] = "Membership Fee Details";
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h1 class="h3 mb-1">Membership Fee #@Model.MembershipFeeQuangTtid</h1>
        <p class="text-muted mb-0">Chi tiết khoản phí.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">Quay lại</a>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Hội viên</dt>
            <dd class="col-sm-9">@Model.MemberName</dd>

            <dt class="col-sm-3">Số tiền</dt>
            <dd class="col-sm-9">@Model.Amount.ToString("N0") đ</dd>

            <dt class="col-sm-3">Ngày thanh toán</dt>
            <dd class="col-sm-9">@Model.PaymentDate.ToString("dd/MM/yyyy")</dd>

            <dt class="col-sm-3">Phương thức</dt>
            <dd class="col-sm-9">@(Model.PaymentMethod ?? "-")</dd>

            <dt class="col-sm-3">Mã giao dịch</dt>
            <dd class="col-sm-9">@(Model.TransactionCode ?? "-")</dd>

            <dt class="col-sm-3">Gói phí</dt>
            <dd class="col-sm-9">@(Model.FeePackageQuangTt?.PackageName ?? "-")</dd>

            <dt class="col-sm-3">Thời hạn</dt>
            <dd class="col-sm-9">
                @(Model.StartDate?.ToString("dd/MM/yyyy") ?? "-")
                →
                @(Model.EndDate?.ToString("dd/MM/yyyy") ?? "-")
            </dd>

            <dt class="col-sm-3">Status / Active</dt>
            <dd class="col-sm-9">
                @(Model.Status?.ToString() ?? "-")
                @if (Model.IsActive)
                {
                    <span class="badge bg-success ms-1">Active</span>
                }
                else
                {
                    <span class="badge bg-secondary ms-1">Inactive</span>
                }
            </dd>

            <dt class="col-sm-3">Publish date</dt>
            <dd class="col-sm-9">@(Model.PublishDate?.ToString("dd/MM/yyyy") ?? "-")</dd>

            <dt class="col-sm-3">Update at</dt>
            <dd class="col-sm-9">@(Model.UpdateAt?.ToString("dd/MM/yyyy HH:mm") ?? "-")</dd>

            <dt class="col-sm-3">Ghi chú</dt>
            <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Notes) ? "-" : Model.Notes)</dd>
        </dl>
    </div>
    <div class="card-footer bg-white d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.MembershipFeeQuangTtid" class="btn btn-primary">Edit</a>
        <a asp-action="Delete" asp-route-id="@Model.MembershipFeeQuangTtid" class="btn btn-outline-danger">Delete</a>
    </div>
</div>
