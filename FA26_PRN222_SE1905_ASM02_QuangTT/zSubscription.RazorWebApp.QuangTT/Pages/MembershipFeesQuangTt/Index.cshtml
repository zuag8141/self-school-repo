@page
@model zSubscription.RazorWebApp.QuangTT.Pages.MembershipFeesQuangTt.IndexModel
@{
    ViewData["Title"] = "Membership Fees";
}

<div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-2 mb-3">
    <div>
        <h1 class="h3 mb-1">Membership Fees</h1>
        <p class="text-muted mb-0">
            Razor Pages CRUD · tìm kiếm 3 tiêu chí · phân trang jQuery · CRUD SignalR.
        </p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-page="Create" class="btn btn-primary">Create New</a>
        <button type="button" id="btnSignalRCreate" class="btn btn-success"
                data-bs-toggle="modal" data-bs-target="#signalRModal">
            SignalR Create
        </button>
    </div>
</div>

<div id="hubStatus" class="alert alert-secondary py-2 small mb-3" role="status">
    Đang kết nối SignalR...
</div>

@if (TempData["Success"] is string successMessage)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @successMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<form method="get" class="card card-body shadow-sm mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-md-3">
            <label asp-for="MemberName" class="form-label">Tên hội viên</label>
            <input asp-for="MemberName" class="form-control" placeholder="VD: Nguyễn Văn An" />
        </div>
        <div class="col-md-3">
            <label asp-for="PaymentMethod" class="form-label">Phương thức thanh toán</label>
            <input asp-for="PaymentMethod" class="form-control" placeholder="Cash / Banking / Momo..." />
        </div>
        <div class="col-md-3">
            <label asp-for="PackageName" class="form-label">Tên gói</label>
            <input asp-for="PackageName" class="form-control" placeholder="VD: Premium" />
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-outline-primary">Tìm kiếm</button>
            <a asp-page="Index" class="btn btn-outline-secondary">Xoá lọc</a>
        </div>
    </div>
</form>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table id="membershipFeeTable" class="table table-striped table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Hội viên</th>
                    <th>Thanh toán</th>
                    <th>Thời hạn</th>
                    <th>Gói</th>
                    <th>Trạng thái</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.MembershipFees.Count == 0)
                {
                    <tr class="js-empty-row">
                        <td colspan="6" class="text-center text-muted py-4">Không có dữ liệu phù hợp.</td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model.MembershipFees)
                    {
                        <tr>
                            <td>
                                <div class="fw-semibold">@item.MemberName</div>
                                <div class="text-muted small">@item.TransactionCode</div>
                            </td>
                            <td>
                                <div class="fw-semibold">@item.Amount.ToString("N0") đ</div>
                                <div class="text-muted small">
                                    @item.PaymentMethod · @item.PaymentDate.ToString("dd/MM/yyyy")
                                </div>
                            </td>
                            <td>
                                <div>
                                    @(item.StartDate?.ToString("dd/MM/yyyy") ?? "-")
                                    →
                                    @(item.EndDate?.ToString("dd/MM/yyyy") ?? "-")
                                </div>
                                <div class="text-muted small">
                                    Publish: @(item.PublishDate?.ToString("dd/MM/yyyy") ?? "-")
                                </div>
                            </td>
                            <td>@(item.FeePackageQuangTt?.PackageName ?? "-")</td>
                            <td>
                                <div class="small">Status: @(item.Status?.ToString() ?? "-")</div>
                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="d-flex flex-wrap gap-1 justify-content-end">
                                    <a asp-page="./Details" asp-route-id="@item.MembershipFeeQuangTtid"
                                       class="btn btn-sm btn-outline-secondary">Details</a>
                                    <a asp-page="./Edit" asp-route-id="@item.MembershipFeeQuangTtid"
                                       class="btn btn-sm btn-outline-primary">Edit</a>
                                    <a asp-page="./Delete" asp-route-id="@item.MembershipFeeQuangTtid"
                                       class="btn btn-sm btn-outline-danger">Delete</a>
                                    <button type="button" class="btn btn-sm btn-success btn-sr-edit"
                                            data-id="@item.MembershipFeeQuangTtid">
                                        SignalR Edit
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-warning btn-sr-delete"
                                            data-id="@item.MembershipFeeQuangTtid">
                                        SignalR Delete
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
    <div class="card-footer bg-white">
        <div class="d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-2">
            <div class="d-flex align-items-center gap-2">
                <label for="feePageSize" class="small text-muted mb-0">Số dòng/trang</label>
                <select id="feePageSize" class="form-select form-select-sm" style="width:auto">
                    <option value="5">5</option>
                    <option value="10" selected>10</option>
                    <option value="20">20</option>
                    <option value="50">50</option>
                </select>
            </div>
            <div id="feePageInfo" class="small text-muted"></div>
            <nav id="feePager" aria-label="Phân trang"></nav>
        </div>
    </div>
</div>

<div class="modal fade" id="signalRModal" tabindex="-1" aria-labelledby="signalRModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <form id="signalRFeeForm" novalidate>
                <div class="modal-header">
                    <h2 class="modal-title fs-5" id="signalRModalLabel">SignalR Create</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="srMembershipFeeQuangTtid" value="0" />
                    <div id="signalRFormError" class="alert alert-danger d-none py-2 small" role="alert"></div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="srMemberName" class="form-label">Tên hội viên <span class="text-danger">*</span></label>
                            <input id="srMemberName" class="form-control" maxlength="250" required />
                        </div>
                        <div class="col-md-6">
                            <label for="srAmount" class="form-label">Số tiền <span class="text-danger">*</span></label>
                            <input id="srAmount" type="number" min="0.01" step="0.01" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label for="srPaymentDate" class="form-label">Ngày thanh toán</label>
                            <input id="srPaymentDate" type="date" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label for="srPaymentMethod" class="form-label">Phương thức thanh toán</label>
                            <input id="srPaymentMethod" class="form-control" maxlength="100" placeholder="Cash / Banking / Momo..." />
                        </div>
                        <div class="col-md-6">
                            <label for="srTransactionCode" class="form-label">Mã giao dịch</label>
                            <input id="srTransactionCode" class="form-control" maxlength="100" />
                        </div>
                        <div class="col-md-6">
                            <label for="srFeePackage" class="form-label">Gói phí</label>
                            <select id="srFeePackage" class="form-select">
                                <option value="">-- Chọn gói --</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label for="srStartDate" class="form-label">Ngày bắt đầu</label>
                            <input id="srStartDate" type="date" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label for="srEndDate" class="form-label">Ngày kết thúc</label>
                            <input id="srEndDate" type="date" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label for="srStatus" class="form-label">Status</label>
                            <input id="srStatus" type="number" class="form-control" placeholder="1" />
                        </div>
                        <div class="col-md-6">
                            <label for="srPublishDate" class="form-label">Ngày publish</label>
                            <input id="srPublishDate" type="date" class="form-control" />
                        </div>
                        <div class="col-12">
                            <label for="srNotes" class="form-label">Ghi chú</label>
                            <textarea id="srNotes" class="form-control" rows="2"></textarea>
                        </div>
                        <div class="col-12">
                            <div class="form-check">
                                <input id="srIsActive" type="checkbox" class="form-check-input" checked />
                                <label for="srIsActive" class="form-check-label">Is Active</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Huỷ</button>
                    <button type="submit" id="btnSignalRSave" class="btn btn-success">Create via SignalR</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/signalr/signalr.min.js"></script>
    <script src="~/js/membership-fees-signalr.js" asp-append-version="true"></script>
    <script>
        $(function () {
            tablePagination.init({
                table: "#membershipFeeTable",
                pager: "#feePager",
                info: "#feePageInfo",
                pageSizeSelector: "#feePageSize",
                pageSize: 10
            });
        });
    </script>
}
