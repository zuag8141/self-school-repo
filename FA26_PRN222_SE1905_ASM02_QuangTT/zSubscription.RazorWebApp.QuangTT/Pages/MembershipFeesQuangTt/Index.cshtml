@page
@model zSubscription.RazorWebApp.QuangTT.Pages.MembershipFeesQuangTt.IndexModel
@{
    ViewData["Title"] = "Membership Fees";
}

<div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-2 mb-3">
    <div>
        <h1 class="h3 mb-1">Membership Fees</h1>
        <p class="text-muted mb-0">Razor Pages CRUD · tìm kiếm 3 tiêu chí · phân trang jQuery (không SignalR).</p>
    </div>
    <a asp-page="Create" class="btn btn-primary">Create New</a>
</div>

@if (TempData["Success"] is string successMessage)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @successMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<form method="get" class="card card-body shadow-sm mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-md-3">
            <label asp-for="MemberName" class="form-label">Tên hội viên</label>
            <input asp-for="MemberName" class="form-control" placeholder="VD: Nguyễn Văn An" />
        </div>
        <div class="col-md-3">
            <label asp-for="PaymentMethod" class="form-label">Phương thức thanh toán</label>
            <input asp-for="PaymentMethod" class="form-control" placeholder="Cash / Banking / Momo..." />
        </div>
        <div class="col-md-3">
            <label asp-for="PackageName" class="form-label">Tên gói</label>
            <input asp-for="PackageName" class="form-control" placeholder="VD: Premium" />
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-outline-primary">Tìm kiếm</button>
            <a asp-page="Index" class="btn btn-outline-secondary">Xoá lọc</a>
        </div>
    </div>
</form>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table id="membershipFeeTable" class="table table-striped table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Hội viên</th>
                    <th>Thanh toán</th>
                    <th>Thời hạn</th>
                    <th>Gói</th>
                    <th>Trạng thái</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.MembershipFees.Count == 0)
                {
                    <tr class="js-empty-row">
                        <td colspan="6" class="text-center text-muted py-4">Không có dữ liệu phù hợp.</td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model.MembershipFees)
                    {
                        <tr>
                            <td>
                                <div class="fw-semibold">@item.MemberName</div>
                                <div class="text-muted small">@item.TransactionCode</div>
                            </td>
                            <td>
                                <div class="fw-semibold">@item.Amount.ToString("N0") đ</div>
                                <div class="text-muted small">
                                    @item.PaymentMethod · @item.PaymentDate.ToString("dd/MM/yyyy")
                                </div>
                            </td>
                            <td>
                                <div>
                                    @(item.StartDate?.ToString("dd/MM/yyyy") ?? "-")
                                    →
                                    @(item.EndDate?.ToString("dd/MM/yyyy") ?? "-")
                                </div>
                                <div class="text-muted small">
                                    Publish: @(item.PublishDate?.ToString("dd/MM/yyyy") ?? "-")
                                </div>
                            </td>
                            <td>@(item.FeePackageQuangTt?.PackageName ?? "-")</td>
                            <td>
                                <div class="small">Status: @(item.Status?.ToString() ?? "-")</div>
                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="d-flex flex-wrap gap-1 justify-content-end">
                                    <a asp-page="./Details" asp-route-id="@item.MembershipFeeQuangTtid"
                                       class="btn btn-sm btn-outline-secondary">Details</a>
                                    <a asp-page="./Edit" asp-route-id="@item.MembershipFeeQuangTtid"
                                       class="btn btn-sm btn-outline-primary">Edit</a>
                                    <a asp-page="./Delete" asp-route-id="@item.MembershipFeeQuangTtid"
                                       class="btn btn-sm btn-outline-danger">Delete</a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
    <div class="card-footer bg-white">
        <div class="d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-2">
            <div class="d-flex align-items-center gap-2">
                <label for="feePageSize" class="small text-muted mb-0">Số dòng/trang</label>
                <select id="feePageSize" class="form-select form-select-sm" style="width:auto">
                    <option value="5">5</option>
                    <option value="10" selected>10</option>
                    <option value="20">20</option>
                    <option value="50">50</option>
                </select>
            </div>
            <div id="feePageInfo" class="small text-muted"></div>
            <nav id="feePager" aria-label="Phân trang"></nav>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            tablePagination.init({
                table: "#membershipFeeTable",
                pager: "#feePager",
                info: "#feePageInfo",
                pageSizeSelector: "#feePageSize",
                pageSize: 10
            });
        });
    </script>
}
