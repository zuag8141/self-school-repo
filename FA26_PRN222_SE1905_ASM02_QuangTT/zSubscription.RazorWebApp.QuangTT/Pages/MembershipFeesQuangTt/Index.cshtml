@page
@model zSubscription.RazorWebApp.QuangTT.Pages.MembershipFeesQuangTt.IndexModel
@{
    ViewData["Title"] = "Membership Fees";
}

<div class="d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-2 mb-3">
    <div>
        <h1 class="h3 mb-1">Membership Fees (CRUD)</h1>
        <p class="text-muted mb-0">Razor Pages CRUD + SignalR auto-refresh khi dữ liệu thay đổi.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-page="./SignalR" class="btn btn-outline-success">SignalR CRUD</a>
        <a asp-page="Create" class="btn btn-primary">Create New</a>
    </div>
</div>

<form method="get" class="row g-2 align-items-end mb-3">
    <div class="col-md-4">
        <label asp-for="MemberName" class="form-label">Member name</label>
        <input asp-for="MemberName" class="form-control" placeholder="Search member..." />
    </div>
    <div class="col-md-4">
        <label asp-for="PaymentMethod" class="form-label">Payment method</label>
        <input asp-for="PaymentMethod" class="form-control" placeholder="Cash, card, transfer..." />
    </div>
    <div class="col-md-4">
        <label asp-for="PackageName" class="form-label">Package name</label>
        <input asp-for="PackageName" class="form-control" placeholder="Search package..." />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Search</button>
        <a asp-page="./Index" class="btn btn-outline-secondary">Show All</a>
    </div>
</form>

<div id="signalrStatus" class="alert alert-info py-2 small d-none"></div>

<div class="table-responsive">
    <table id="membershipFeeTable" class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>Member</th>
                <th>Payment</th>
                <th>Subscription Period</th>
                <th>Package</th>
                <th>Status</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model.MembershipFees)
        {
            <tr>
                <td>
                    <div class="fw-semibold">@item.MemberName</div>
                    <div class="text-muted small">@item.TransactionCode</div>
                </td>
                <td>
                    <div class="fw-semibold">@item.Amount.ToString("N2")</div>
                    <div class="text-muted small">@item.PaymentMethod - @item.PaymentDate.ToString("dd/MM/yyyy")</div>
                </td>
                <td>
                    <div>@(item.StartDate?.ToString("dd/MM/yyyy") ?? "-") - @(item.EndDate?.ToString("dd/MM/yyyy") ?? "-")</div>
                    <div class="text-muted small">Published: @(item.PublishDate?.ToString("dd/MM/yyyy") ?? "-")</div>
                </td>
                <td>@(item.FeePackageQuangTt?.PackageName ?? "-")</td>
                <td>
                    <div>Status: @(item.Status?.ToString() ?? "-")</div>
                    @if (item.IsActive)
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Inactive</span>
                    }
                </td>
                <td class="text-end">
                    <a asp-page="./Details" asp-route-id="@item.MembershipFeeQuangTtid" class="btn btn-sm btn-outline-secondary">Details</a>
                    <a asp-page="./Edit" asp-route-id="@item.MembershipFeeQuangTtid" class="btn btn-sm btn-outline-primary">Edit</a>
                    <a asp-page="./Delete" asp-route-id="@item.MembershipFeeQuangTtid" class="btn btn-sm btn-outline-danger">Delete</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"
            crossorigin="anonymous"
            referrerpolicy="no-referrer"></script>
    <script>
        const statusEl = document.getElementById("signalrStatus");
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/membershipFeeHub")
            .withAutomaticReconnect()
            .build();

        connection.on("MembershipFeeChanged", function (payload) {
            statusEl.classList.remove("d-none");
            statusEl.textContent = `Realtime: ${payload.action} "${payload.memberName || ""}" at ${payload.changedAt}. Reloading...`;
            setTimeout(() => window.location.reload(), 600);
        });

        connection.start()
            .then(() => {
                statusEl.classList.remove("d-none", "alert-danger");
                statusEl.classList.add("alert-info");
                statusEl.textContent = "SignalR connected. List will auto-refresh on changes.";
            })
            .catch(err => {
                statusEl.classList.remove("d-none", "alert-info");
                statusEl.classList.add("alert-danger");
                statusEl.textContent = "SignalR connection failed: " + err.toString();
            });
    </script>
}
