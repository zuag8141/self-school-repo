@page
@model zSubscription.RazorWebApp.QuangTT.Pages.MembershipFeesQuangTt.SignalRModel
@{
    ViewData["Title"] = "SignalR CRUD";
}

<div class="d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-2 mb-3">
    <div>
        <h1 class="h3 mb-1">Membership Fees (SignalR CRUD)</h1>
        <p class="text-muted mb-0">Toàn bộ Create / Update / Delete / Search chạy qua Hub, cập nhật realtime không reload form.</p>
    </div>
    <a asp-page="./Index" class="btn btn-outline-secondary">Back to Razor CRUD</a>
</div>

<div id="hubStatus" class="alert alert-secondary py-2 small">Connecting SignalR...</div>

<form id="searchForm" class="row g-2 align-items-end mb-3">
    <div class="col-md-3">
        <label class="form-label">Member name</label>
        <input id="searchMemberName" class="form-control" placeholder="Search member..." />
    </div>
    <div class="col-md-3">
        <label class="form-label">Payment method</label>
        <input id="searchPaymentMethod" class="form-control" placeholder="Cash, card..." />
    </div>
    <div class="col-md-3">
        <label class="form-label">Package name</label>
        <input id="searchPackageName" class="form-control" placeholder="Search package..." />
    </div>
    <div class="col-md-3">
        <button type="submit" class="btn btn-outline-primary">Search</button>
        <button type="button" id="btnShowAll" class="btn btn-outline-secondary">Show All</button>
    </div>
</form>

<div class="row g-3">
    <div class="col-lg-4">
        <div class="card shadow-sm">
            <div class="card-body">
                <h2 class="h5" id="formTitle">Create</h2>
                <form id="feeForm" class="compact-form">
                    <input type="hidden" id="MembershipFeeQuangTtid" value="0" />
                    <div class="mb-2">
                        <label class="form-label">Member Name</label>
                        <input id="MemberName" class="form-control" required />
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Amount</label>
                        <input id="Amount" type="number" step="0.01" class="form-control" required />
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Payment Date</label>
                        <input id="PaymentDate" type="date" class="form-control" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Payment Method</label>
                        <input id="PaymentMethod" class="form-control" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Transaction Code</label>
                        <input id="TransactionCode" class="form-control" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Start Date</label>
                        <input id="StartDate" type="date" class="form-control" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label">End Date</label>
                        <input id="EndDate" type="date" class="form-control" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Notes</label>
                        <input id="Notes" class="form-control" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Status</label>
                        <input id="Status" type="number" class="form-control" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Publish Date</label>
                        <input id="PublishDate" type="date" class="form-control" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Fee Package</label>
                        <select id="FeePackageQuangTtid" class="form-select"></select>
                    </div>
                    <div class="form-check mb-3">
                        <input id="IsActive" type="checkbox" class="form-check-input" checked />
                        <label class="form-check-label" for="IsActive">Is Active</label>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary" id="btnSave">Create</button>
                        <button type="button" class="btn btn-outline-secondary" id="btnReset">Reset</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="col-lg-8">
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead>
                    <tr>
                        <th>Member</th>
                        <th>Payment</th>
                        <th>Package</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody id="feeTableBody">
                    <tr><td colspan="5" class="text-muted">Loading...</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"
            crossorigin="anonymous"
            referrerpolicy="no-referrer"></script>
    <script>
        const statusEl = document.getElementById("hubStatus");
        const tableBody = document.getElementById("feeTableBody");
        const packageSelect = document.getElementById("FeePackageQuangTtid");
        const formTitle = document.getElementById("formTitle");
        const btnSave = document.getElementById("btnSave");

        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/membershipFeeHub")
            .withAutomaticReconnect()
            .build();

        function today() {
            return new Date().toISOString().slice(0, 10);
        }

        function setStatus(text, type = "info") {
            statusEl.className = `alert alert-${type} py-2 small`;
            statusEl.textContent = text;
        }

        function readForm() {
            return {
                membershipFeeQuangTtid: Number(document.getElementById("MembershipFeeQuangTtid").value || 0),
                memberName: document.getElementById("MemberName").value,
                amount: Number(document.getElementById("Amount").value || 0),
                paymentDate: document.getElementById("PaymentDate").value || null,
                paymentMethod: document.getElementById("PaymentMethod").value || null,
                transactionCode: document.getElementById("TransactionCode").value || null,
                startDate: document.getElementById("StartDate").value || null,
                endDate: document.getElementById("EndDate").value || null,
                notes: document.getElementById("Notes").value || null,
                status: document.getElementById("Status").value === "" ? null : Number(document.getElementById("Status").value),
                publishDate: document.getElementById("PublishDate").value || null,
                feePackageQuangTtid: document.getElementById("FeePackageQuangTtid").value === "" ? null : Number(document.getElementById("FeePackageQuangTtid").value),
                isActive: document.getElementById("IsActive").checked
            };
        }

        function resetForm() {
            document.getElementById("MembershipFeeQuangTtid").value = 0;
            document.getElementById("MemberName").value = "";
            document.getElementById("Amount").value = "";
            document.getElementById("PaymentDate").value = today();
            document.getElementById("PaymentMethod").value = "";
            document.getElementById("TransactionCode").value = "";
            document.getElementById("StartDate").value = "";
            document.getElementById("EndDate").value = "";
            document.getElementById("Notes").value = "";
            document.getElementById("Status").value = "";
            document.getElementById("PublishDate").value = today();
            packageSelect.value = "";
            document.getElementById("IsActive").checked = true;
            formTitle.textContent = "Create";
            btnSave.textContent = "Create";
        }

        function fillForm(item) {
            document.getElementById("MembershipFeeQuangTtid").value = item.membershipFeeQuangTtid;
            document.getElementById("MemberName").value = item.memberName || "";
            document.getElementById("Amount").value = item.amount ?? "";
            document.getElementById("PaymentDate").value = item.paymentDate || "";
            document.getElementById("PaymentMethod").value = item.paymentMethod || "";
            document.getElementById("TransactionCode").value = item.transactionCode || "";
            document.getElementById("StartDate").value = item.startDate || "";
            document.getElementById("EndDate").value = item.endDate || "";
            document.getElementById("Notes").value = item.notes || "";
            document.getElementById("Status").value = item.status ?? "";
            document.getElementById("PublishDate").value = item.publishDate || "";
            packageSelect.value = item.feePackageQuangTtid ?? "";
            document.getElementById("IsActive").checked = !!item.isActive;
            formTitle.textContent = "Edit #" + item.membershipFeeQuangTtid;
            btnSave.textContent = "Update";
        }

        function renderRows(items) {
            if (!items || items.length === 0) {
                tableBody.innerHTML = `<tr><td colspan="5" class="text-muted">No records found</td></tr>`;
                return;
            }

            tableBody.innerHTML = items.map(item => `
                <tr>
                    <td>
                        <div class="fw-semibold">${item.memberName || ""}</div>
                        <div class="text-muted small">${item.transactionCode || ""}</div>
                    </td>
                    <td>
                        <div class="fw-semibold">${Number(item.amount || 0).toLocaleString()}</div>
                        <div class="text-muted small">${item.paymentMethod || ""} - ${item.paymentDate || ""}</div>
                    </td>
                    <td>${item.packageName || "-"}</td>
                    <td>
                        <div>Status: ${item.status ?? "-"}</div>
                        <span class="badge ${item.isActive ? "bg-success" : "bg-secondary"}">${item.isActive ? "Active" : "Inactive"}</span>
                    </td>
                    <td class="text-end">
                        <button type="button" class="btn btn-sm btn-outline-primary btn-edit" data-id="${item.membershipFeeQuangTtid}">Edit</button>
                        <button type="button" class="btn btn-sm btn-outline-danger btn-delete" data-id="${item.membershipFeeQuangTtid}">Delete</button>
                    </td>
                </tr>
            `).join("");
        }

        async function loadPackages() {
            const packages = await connection.invoke("GetPackages");
            packageSelect.innerHTML = `<option value="">-- Select package --</option>` +
                packages.map(p => `<option value="${p.feePackageQuangTtid}">${p.packageName}</option>`).join("");
        }

        async function loadData() {
            const items = await connection.invoke(
                "GetAll",
                document.getElementById("searchMemberName").value || null,
                document.getElementById("searchPaymentMethod").value || null,
                document.getElementById("searchPackageName").value || null
            );
            renderRows(items);
        }

        connection.on("MembershipFeeChanged", async function (payload) {
            setStatus(`Realtime event: ${payload.action} "${payload.memberName || ""}" at ${payload.changedAt}`, "success");
            await loadData();
        });

        document.getElementById("feeForm").addEventListener("submit", async function (e) {
            e.preventDefault();
            const dto = readForm();
            try {
                const items = dto.membershipFeeQuangTtid > 0
                    ? await connection.invoke("Update", dto)
                    : await connection.invoke("Create", dto);
                renderRows(items);
                resetForm();
                setStatus(dto.membershipFeeQuangTtid > 0 ? "Updated via SignalR." : "Created via SignalR.", "success");
            } catch (err) {
                setStatus(err.toString(), "danger");
            }
        });

        document.getElementById("btnReset").addEventListener("click", resetForm);

        document.getElementById("searchForm").addEventListener("submit", async function (e) {
            e.preventDefault();
            await loadData();
        });

        document.getElementById("btnShowAll").addEventListener("click", async function () {
            document.getElementById("searchMemberName").value = "";
            document.getElementById("searchPaymentMethod").value = "";
            document.getElementById("searchPackageName").value = "";
            await loadData();
        });

        tableBody.addEventListener("click", async function (e) {
            const editBtn = e.target.closest(".btn-edit");
            const deleteBtn = e.target.closest(".btn-delete");

            if (editBtn) {
                const item = await connection.invoke("GetById", Number(editBtn.dataset.id));
                if (item) fillForm(item);
            }

            if (deleteBtn) {
                if (!confirm("Delete this membership fee?")) return;
                try {
                    const items = await connection.invoke("Delete", Number(deleteBtn.dataset.id));
                    renderRows(items);
                    resetForm();
                    setStatus("Deleted via SignalR.", "success");
                } catch (err) {
                    setStatus(err.toString(), "danger");
                }
            }
        });

        connection.start()
            .then(async () => {
                setStatus("SignalR connected. CRUD is live.", "info");
                resetForm();
                await loadPackages();
                await loadData();
            })
            .catch(err => setStatus("SignalR failed: " + err.toString(), "danger"));
    </script>
}
