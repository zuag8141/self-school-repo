@model zSubscription.RazorWebApp.QuangTT.Pages.MembershipFeesQuangTt.MembershipFeeFormPageModel

<div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

<div class="row g-3">
    <div class="col-md-6">
        <label asp-for="MembershipFee.MemberName" class="form-label"></label>
        <input asp-for="MembershipFee.MemberName" class="form-control" placeholder="VD: Nguyễn Văn An" />
        <span asp-validation-for="MembershipFee.MemberName" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="MembershipFee.Amount" class="form-label"></label>
        <input asp-for="MembershipFee.Amount" type="number" min="0.01" step="0.01" class="form-control" />
        <span asp-validation-for="MembershipFee.Amount" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="MembershipFee.PaymentDate" class="form-label"></label>
        <input asp-for="MembershipFee.PaymentDate" type="date" class="form-control" />
        <span asp-validation-for="MembershipFee.PaymentDate" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="MembershipFee.PaymentMethod" class="form-label"></label>
        <input asp-for="MembershipFee.PaymentMethod" class="form-control" placeholder="Cash / Banking / Momo..." />
        <span asp-validation-for="MembershipFee.PaymentMethod" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="MembershipFee.TransactionCode" class="form-label"></label>
        <input asp-for="MembershipFee.TransactionCode" class="form-control" placeholder="VD: GD-2026-036" />
        <span asp-validation-for="MembershipFee.TransactionCode" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="MembershipFee.FeePackageQuangTtid" class="form-label"></label>
        <select asp-for="MembershipFee.FeePackageQuangTtid" asp-items="ViewBag.FeePackageQuangTtid" class="form-select">
            <option value="">-- Chọn gói phí --</option>
        </select>
        <span asp-validation-for="MembershipFee.FeePackageQuangTtid" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="MembershipFee.StartDate" class="form-label"></label>
        <input asp-for="MembershipFee.StartDate" type="date" class="form-control" />
        <span asp-validation-for="MembershipFee.StartDate" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="MembershipFee.EndDate" class="form-label"></label>
        <input asp-for="MembershipFee.EndDate" type="date" class="form-control" />
        <span asp-validation-for="MembershipFee.EndDate" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="MembershipFee.Status" class="form-label"></label>
        <input asp-for="MembershipFee.Status" type="number" class="form-control" placeholder="0/1/2" />
        <span asp-validation-for="MembershipFee.Status" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="MembershipFee.PublishDate" class="form-label"></label>
        <input asp-for="MembershipFee.PublishDate" type="date" class="form-control" />
        <span asp-validation-for="MembershipFee.PublishDate" class="text-danger small"></span>
    </div>
    <div class="col-md-4 d-flex align-items-end">
        <div class="form-check mb-2">
            <input asp-for="MembershipFee.IsActive" class="form-check-input" />
            <label asp-for="MembershipFee.IsActive" class="form-check-label"></label>
        </div>
    </div>
    <div class="col-12">
        <label asp-for="MembershipFee.Notes" class="form-label"></label>
        <textarea asp-for="MembershipFee.Notes" class="form-control" rows="3"></textarea>
        <span asp-validation-for="MembershipFee.Notes" class="text-danger small"></span>
    </div>
</div>
